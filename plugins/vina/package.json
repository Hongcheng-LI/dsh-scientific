{
  "name": "dsh-vina",
  "version": "0.1.0",
  "description": "AutoDock Vina molecular docking tools for DeepSeek Harness (skeleton: tools planned, see README)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "vina",
    "docking",
    "computational-chemistry"
  ],
  "author": "Hongcheng Li",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
